{
  "name": "urstaat-research-graph",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:data": "python scripts/build-graph-model.py",
    "refresh:data": "python scripts/build-graph-model.py --refresh",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/graph-browser.mjs",
    "test:part-2": "node tests/part-2-browser.mjs",
    "test:taku": "node tests/taku-browser.mjs",
    "test:atlas": "node tests/taku-atlas-browser.mjs",
    "build:taku-globe": "node scripts/build-taku-globe.mjs",
    "render:taku-stills": "node scripts/render-taku-stills.mjs"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "echarts": "6.1.0",
    "motion": "14.14.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer": "25.17.0"
  }
}
